# 依赖与构建产物
node_modules/
.next/
out/
build/
coverage/

# 环境与密钥（凭据绝不入库）
.env
.env.local
.env*.local
*.pem
*.key
secrets/

# 数据库与备份
prisma/dev.db
prisma/dev.db-journal
prisma/dev.db.bak
# E2E 独立数据库（P05，每次运行重建）
prisma/e2e.db
prisma/e2e.db-journal
prisma/e2e.db-wal
prisma/e2e.db-shm
backups/

# 运行时与临时（生命周期：Local/Temporary 绝不入库）
/logs/
*.log
.local/
tmp/
.cache/
# 运行时写入根（D-09 DATA_DIR 化；D-10 迁移出 git）
# 只匹配仓库根的同名目录：`data/` 不带前导斜杠会误伤 src/components/web/data/（源码目录），
# 导致该目录新增文件被静默忽略。
/uploads/
/data/
# 视觉回归占位图：由 prisma/seed-visual.ts 运行时生成（CI 亦重新生成），不进仓库。
# 显式声明，替代原先 `uploads/` 无前导斜杠时的顺带覆盖。
/public/uploads/visual-fixtures/

# IDE 与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# AI 编码助手的文件写入标记（box-agent 在每个被编辑文件旁生成 .<name>.artifact.json，
# 内容形如 {"retain_for_chat":true}；属运行时产物，绝不入库）
**/.*.artifact.json

/.box-agent/
