generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// Phase 1.1.1: User表和Role表 (RBAC权限控制)
// ============================================

model Role {
  id          Int       @id @default(autoincrement())
  name        String    @unique // 角色名称: SuperAdmin/Editor/Viewer
  slug        String    @unique // 角色标识: super-admin/editor/viewer
  description String?   // 角色描述

  // 权限配置（JSON数组）
  permissions String    // ["article:create", "article:edit", "*"]
  isSuper     Boolean   @default(false) // 是否超级管理员

  // 关联
  users User[]

  // 状态
  status String @default("active")

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 索引
  @@index([slug])
  @@index([status])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique // 登录用户名
  passwordHash String   // bcrypt哈希密码
  email        String?  @unique // 电子邮箱

  // 个人信息
  nickname String? // 显示昵称
  realName String? // 真实姓名
  avatar   String? // 头像URL
  phone    String? // 手机号

  // 角色与权限
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  // 状态
  isActive Boolean @default(true)
  status   String  @default("active") // active/inactive/banned

  // 登录记录
  lastLoginAt DateTime?
  lastLoginIp String?
  loginCount  Int       @default(0)

  // 关联
  articles Article[]
  media    Media[]
  logs     OperationLog[]

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 索引
  @@index([username])
  @@index([email])
  @@index([roleId])
  @@index([status])
}

// ============================================
// Phase 1.1.2: Navigation表 (无限极层级导航)
// ============================================

model Navigation {
  id   Int    @id @default(autoincrement())
  name String // 菜单名称
  slug String @unique // URL标识

  // 层级关系（自关联）
  parentId Int?
  parent   Navigation?  @relation("NavigationHierarchy", fields: [parentId], references: [id])
  children Navigation[] @relation("NavigationHierarchy")
  level    Int          @default(1) // 层级：1/2/3

  // 链接配置
  icon     String? // 图标名称
  link     String? // 跳转链接
  linkType String  @default("internal") // internal/external/dropdown
  target   String  @default("_self") // _self/_blank

  // 模板与内容关联
  templateId  Int?
  template    PageTemplate? @relation(fields: [templateId], references: [id])
  categoryId  Int?
  category    Category?     @relation(fields: [categoryId], references: [id])
  contentType String?       // news/course/partner/page

  // 显示配置
  sort      Int     @default(0)
  status    String  @default("active")
  isVisible Boolean @default(true)
  isNav     Boolean @default(true)

  // 元数据
  metadata        String? // JSON: { badge, description }
  hoverEffect     String? // JSON: { type: "bg-change", color: "#2d4a6f" }
  clickAction     String? // JSON: { type: "navigate", target: "/path" }
  activeIndicator String? // 激活状态指示器样式

  // SEO配置
  seoTitle       String?
  seoKeywords    String?
  seoDescription String?

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 反向关联
  elements ElementConfig[]

  // 索引
  @@index([parentId])
  @@index([level])
  @@index([slug])
  @@index([sort])
  @@index([status])
  @@index([isVisible])
  @@index([templateId])
  @@index([categoryId])
}

// ============================================
// Phase 1.1.3: Category表 (多级分类)
// ============================================

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  image       String?

  // 层级关系（自关联）
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  // 类型与模板
  type           String  @default("article") // article/course/partner
  templateList   String? // 列表页模板code
  templateDetail String? // 详情页模板code

  // SEO配置
  seoTitle       String?
  seoKeywords    String?
  seoDescription String?

  // 显示配置
  sort      Int     @default(0)
  isNav     Boolean @default(false)
  isVisible Boolean @default(true)

  // 关联
  articles    Article[]
  courses     Course[]
  majors      Major[]
  navigations Navigation[]

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 索引
  @@index([parentId])
  @@index([type])
  @@index([slug])
  @@index([isVisible])
  @@index([sort])
}

model Major {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  duration    String?
  cover       String?
  status      String   @default("active")
  sort        Int      @default(0)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  courses     Course[]
  hotMajors   HotMajor[]
  offerings   EnrollmentOffering[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([sort])
  @@index([categoryId])
}

model Course {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  price       Float     @default(0)
  priceText   String?
  duration    String?
  outline     String?
  cover       String?
  status      String    @default("active")
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  majorId     Int?
  major       Major?    @relation(fields: [majorId], references: [id], onDelete: SetNull)
  students    Student[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([majorId])
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  cover     String?
  views     Int      @default(0)
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Phase 1.1.4: Article表和Tag表 (文章和标签系统)
// ============================================

model Article {
  id        Int    @id @default(autoincrement())
  title     String // 文章标题
  slug      String @unique // URL别名
  content   String // 文章正文
  excerpt   String? // 文章摘要
  coverImage String? // 封面图片

  // 作者与分类
  authorId   Int
  author     User     @relation(fields: [authorId], references: [id])
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  // 标签关联（多对多）
  tags ArticleTag[]

  // 状态与发布
  status      String  @default("draft") // draft/published/archived
  isTop       Boolean @default(false)
  isRecommend Boolean @default(false)
  isHot       Boolean @default(false)

  // 统计
  viewCount Int @default(0)
  likeCount Int @default(0)

  // SEO
  seoTitle       String?
  seoKeywords    String?
  seoDescription String?

  // 时间
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 索引
  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
  @@index([isTop])
  @@index([isRecommend])
  @@index([isHot])
  @@index([slug])
}

model Tag {
  id        Int          @id @default(autoincrement())
  name      String       @unique
  slug      String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now())

  @@index([slug])
}

model ArticleTag {
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     Int
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id])
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Banner {
  id        Int      @id @default(autoincrement())
  image     String
  link      String?
  sort      Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
}

// ============================================
// Phase 1.1.5: Setting表 (系统配置增强)
// ============================================

model Setting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String?
  type        String  @default("string") // string/number/boolean/json
  group       String  @default("general") // basic/contact/seo/social
  description String?
  isPublic    Boolean @default(true)
  isEncrypted Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@index([isPublic])
}

// ============================================
// Phase 2.1: 模板系统数据库
// ============================================

model PageTemplate {
  id          Int             @id @default(autoincrement())
  code        String          @unique // list/article/home/partner-grid
  name        String // 模板名称
  description String?

  // 模板配置
  layout      String  @default("default") // default/sidebar/fullwidth
  contentType String? // news/course/partner
  templateFile String // 模板文件路径
  thumbnail   String? // 缩略图URL

  // 关联内容块
  blocks TemplateBlock[]

  // 默认配置
  config String? // JSON配置

  // 状态
  status    String  @default("active")
  isDefault Boolean @default(false)

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 反向关联
  navigations Navigation[]

  // 索引
  @@index([code])
  @@index([contentType])
  @@index([status])
}

model ContentBlock {
  id   Int    @id @default(autoincrement())
  code String @unique // home-banner/news-list/sidebar
  name String // 内容块名称
  type String // hero/banner/list/grid/sidebar

  // 内容配置
  title    String?
  subtitle String?

  // 数据源
  contentType String? // static/query/api
  query       String? // JSON查询条件
  limit       Int? // 数量限制

  // 内容与样式
  content String? // JSON内容
  style   String? // JSON样式

  // 交互配置
  interactions String? // JSON交互配置

  // 关联
  templates TemplateBlock[]

  // 状态
  status String @default("active")

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 索引
  @@index([type])
  @@index([contentType])
  @@index([status])
}

model TemplateBlock {
  id         Int          @id @default(autoincrement())
  templateId Int
  template   PageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  blockId    Int
  block      ContentBlock @relation(fields: [blockId], references: [id])

  sort   Int     @default(0)
  config String? // 特有配置

  @@index([templateId])
  @@index([blockId])
  @@index([sort])
}

// 招生院校表 - 合作大学展示
model Partner {
  id        Int      @id @default(autoincrement())
  name      String   // 大学名称
  logo      String   // Logo URL
  website   String?  // 官网链接
  sort      Int      @default(0)
  status    String   @default("active")
  offerings EnrollmentOffering[]
  createdAt DateTime @default(now())
}

// 校区表
model Campus {
  id        Int           @id @default(autoincrement())
  name      String        // 校区名称
  address   String?       // 地址
  sort      Int           @default(0)
  status    String        @default("active")
  images    CampusImage[]
  createdAt DateTime      @default(now())
}

// 校区图片表
model CampusImage {
  id        Int      @id @default(autoincrement())
  campusId  Int
  campus    Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)
  image     String   // 图片URL
  caption   String?  // 图片说明
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

// 证书风采/图片展示表
model Gallery {
  id        Int      @id @default(autoincrement())
  title     String   // 标题
  image     String   // 图片URL
  category  String   @default("certificate") // certificate|exam|campus
  sort      Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
}

// 首页四宫格卡片表
model HomeCard {
  id        Int    @id @default(autoincrement())
  title     String // 卡片标题：自学考试/成人高考/开放大学/职业证书
  subtitle  String // 副标题：自助者天助之/成就学员梦想/...
  icon      String @default("MessageSquare") // Lucide图标名称
  href      String @default("/courses") // 跳转链接
  gradient  String @default("from-blue-500 to-blue-600") // Tailwind渐变类
  hoverGradient String @default("from-blue-400 to-blue-500")
  shadow    String @default("shadow-blue-200")
  backgroundImage String? // 卡片背景图片URL
  sort      Int    @default(0)
  status    String @default("active") // active/inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sort])
}

// 服务指南6宫格配置表
model ServiceGuide {
  id        Int      @id @default(autoincrement())
  slug      String?  @unique // URL 别名，若有 content 则可生成 /services/{slug}
  title     String   // 标题：报考条件、报名费用等
  subtitle  String?  // 副标题/简短说明
  content   String?  // 正文（markdown/html），有内容时 /services/{slug} 可访问
  icon      String   // 图标名称
  link      String   // 链接地址（可指向 /services/{slug} 或外部 URL）
  sort      Int      @default(0)
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([slug])
}

// 热门专业配置表（首页课程区块展示）
model HotMajor {
  id          Int    @id @default(autoincrement())
  title       String // 专业名称：如"金融学"
  subtitle    String @default("专升本") // 副标题/分类标签
  description String? // 简介文本
  duration    String @default("2年") // 学制
  majorId     Int?
  major       Major? @relation(fields: [majorId], references: [id], onDelete: SetNull)

  // 图标配置
  iconType  String @default("text") // text | image
  iconImage String? // 自定义图片URL（iconType=image时使用）
  iconColor String @default("from-blue-500 to-blue-600") // 圆形背景渐变（iconType=text时使用）

  // 链接与展示
  link String @default("/apply") // 跳转链接
  sort Int    @default(0) // 排序权重

  // 状态
  status String @default("active") // active / inactive

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 索引
  @@index([status])
  @@index([sort])
  @@index([majorId])
}

model EnrollmentOffering {
  id              Int      @id @default(autoincrement())
  majorId         Int
  major           Major    @relation(fields: [majorId], references: [id], onDelete: Cascade)
  partnerId       Int
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sourceBatch     String   @default("26春")
  educationType   String   @default("自考")
  level           String?
  majorCode       String?
  studyForm       String?
  yearTuition     Float?
  totalTuition    Float?
  feeDetail       String?
  extraFeeNote    String?
  hasPrice        Boolean  @default(false)
  status          String   @default("active")
  sort            Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceBatch, partnerId, majorId, educationType, level, majorCode])
  @@index([majorId, educationType, level, status])
  @@index([partnerId, status])
  @@index([sourceBatch, status])
  @@index([hasPrice, status])
  @@index([totalTuition])
}

// ============================================
// Phase 2.3: 媒体管理系统
// ============================================

model Media {
  id       Int    @id @default(autoincrement())
  filename String // 原始文件名
  path     String // 存储路径
  url      String // 访问URL
  mimeType String // MIME类型
  size     Int    // 文件大小

  type     String  @default("image") // image/video/document
  category String? // banner/article/avatar

  uploaderId Int
  uploader   User @relation(fields: [uploaderId], references: [id])

  metadata String? // JSON: {width, height, duration, thumb, small, medium}

  createdAt DateTime @default(now())

  @@index([uploaderId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
}

// Phase 2.4: 首页服务卡片系统 → 已合并到上方 HomeCard 模型 (line ~467)

// ============================================
// Phase 3.1: 元素配置系统 (712交互点)
// ============================================

model ElementConfig {
  id          Int     @id @default(autoincrement())
  elementId   String  @unique // 如: "001-001"
  elementName String

  layer     Int    // 1-14
  layerName String // "TopBar", "Header", etc.

  navigationId Int?
  navigation   Navigation? @relation(fields: [navigationId], references: [id])

  elementType String? // link/button/card/image/text/icon
  selector    String? // CSS选择器
  position    String? // JSON: {x, y, width, height}

  // 交互配置
  interactions String? // JSON: [{event, action, target}]

  // 状态配置
  normalState String? // JSON: {color, bgColor, border}
  hoverState  String? // JSON: {color, bgColor, scale}
  activeState String? // JSON: {color, bgColor, indicator}

  content String? // 显示内容
  icon    String? // 图标名称

  status String @default("active")
  sort   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([elementId])
  @@index([layer])
  @@index([navigationId])
  @@index([status])
}

// ============================================
// Phase 3.2: AI客服系统
// ============================================

model AIConfig {
  id          Int     @id @default(autoincrement())
  name        String
  apiEndpoint String
  apiKey      String // 加密存储
  model       String  @default("gpt-3.5-turbo")

  systemPrompt String? // 系统提示词
  userPrompt   String? // 用户提示词模板
  greeting     String? // AI开场白

  isActive    Boolean @default(false)
  temperature Float   @default(0.7)
  maxTokens   Int     @default(1000)

  rateLimit      Int     @default(60) // 每分钟请求限制
  dailyQuota     Int     @default(1000) // 每日配额
  allowedDomains String? // 允许的域名

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIChatHistory {
  id             Int      @id @default(autoincrement())
  sessionId      String
  conversationId String

  ipAddress String?
  userAgent String?

  role    String // user/assistant/system
  message String

  model         String?
  temperature   Float?
  tokensUsed    Int?
  responseTime  Int? // 毫秒

  pageUrl   String?
  pageTitle String?
  metadata  String? // JSON

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([conversationId])
  @@index([createdAt])
}

// ============================================
// Phase 3.2.1: AI 知识库
// ============================================
// 为 AI 对话提供可检索的知识片段：FAQ、报考政策、学校信息等
// 支持本地录入或从外部 Notion/Feishu 等同步（source 字段标识）
model Knowledge {
  id      Int    @id @default(autoincrement())
  title   String // 知识条目标题，用于检索结果预览
  content String // 正文内容（markdown 纯文本）
  tags    String // 逗号分隔的标签：zikao,chengkao,kaifang,fee,enrollment
  source  String @default("local") // local / notion / feishu / web

  // 可选：外部源的元信息
  externalId  String? // 外部系统的唯一 ID
  externalUrl String? // 外部原文链接

  priority Int     @default(0) // 越大越优先注入 prompt
  status   String  @default("active") // active / inactive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tags])
}

// ============================================
// Phase 3.2.2: AI 聊天场景（入口差异化）
// ============================================
// 不同前台入口对应不同的 scene，决定欢迎语、系统提示、检索哪些 tag 的知识
model ChatScene {
  id           Int     @id @default(autoincrement())
  code         String  @unique // apply / float / guide / faq 等
  name         String // 场景中文名：如"在线报名全面咨询"
  description  String? // 场景说明
  greeting     String // 会话首句问候语
  systemPrompt String // 系统提示词：角色设定、话术策略
  knowledgeTags String @default("") // 逗号分隔要检索的 Knowledge 标签
  starters     String? // JSON 数组：推荐提问快捷按钮

  // 前台差异化渲染（apply 页按 scene 读取）
  pageTitle       String? // 页面大标题，如"在线报名" / "悬浮咨询" / "政策解答"
  pageSubtitle    String? // 页面副标题
  headerTip       String? // 顶部小提示
  sidebarTitle    String? // 侧边栏主标题，如"报名流程" / "办理流程" / "咨询服务"
  processSteps    String? // JSON 数组 [{title,desc}]：侧边栏步骤
  promiseList     String? // JSON 数组：服务承诺列表
  contactCardTitle String? // 联系卡标题

  // 知识库查询开关（关闭可显著提升AI响应速度）
  useKnowledgeBase Boolean  @default(true)

  status    String   @default("active")
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ============================================
// Phase 3.3: 行为追踪与统计
// ============================================

model UserAction {
  id           Int      @id @default(autoincrement())
  actionType   String   // click/view/submit
  actionTarget String   // phone/wechat/qq/apply

  sessionId String
  ipAddress String?
  userAgent String?

  pageUrl   String?
  pageTitle String?
  referrer  String?

  metadata String? // JSON

  createdAt DateTime @default(now())

  @@index([actionType])
  @@index([sessionId])
  @@index([createdAt])
}

model ViewStats {
  id Int @id @default(autoincrement())

  contentType String // news/course/partner
  contentId   Int
  viewDate    DateTime @default(now())

  pageViews      Int @default(0)
  uniqueVisitors Int @default(0)

  source   String? // direct/search/social
  referrer String?

  @@index([contentType, contentId])
  @@index([viewDate])
}

// ============================================
// Phase 3.4: 操作日志与权限优化
// ============================================

model OperationLog {
  id       Int     @id @default(autoincrement())
  userId   Int?
  user     User?   @relation(fields: [userId], references: [id])
  username String

  module  String // article/user/category/navigation
  action  String // create/update/delete/login
  title   String? // 操作标题
  content String? // JSON: {before, after}

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model ManagerMenu {
  id     Int     @id @default(autoincrement())
  code   String  @unique // dashboard/navigations
  label  String  // 菜单名称
  icon   String  // Lucide图标
  path   String? // 路由路径

  parentId Int?
  parent   ManagerMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children ManagerMenu[] @relation("MenuHierarchy")
  level    Int           @default(1)

  permission String? // 需要的权限

  sort      Int     @default(0)
  isVisible Boolean @default(true)
  badge     String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([level])
  @@index([code])
  @@index([sort])
  @@index([isVisible])
}
