# 复制为 .env.local 并填入实际值（密钥绝不入库、绝不写入文档）

# JWT 密钥（必须 ≥32 字符，缺失启动即 FATAL）
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# 字段加密密钥（AES-256-GCM，覆盖 LLM apiKey/微信 appSecret/SMTP password；默认派生自 JWT_SECRET）
# ENCRYPTION_KEY=

# 数据库（默认 file:./prisma/dev.db）
# DATABASE_URL="file:./prisma/dev.db"

# 生产端口（默认 6789；宝塔 80 反代 → 127.0.0.1:6789）
# PORT=6789

# 站点域名（邮件/素材绝对链接使用）
# APP_DOMAIN=www.hd1994.com
# APP_ORIGIN=https://www.hd1994.com

# 运行时数据目录（D-09 起生效，缺省 ./data；上传/切片/导出等运行时文件落此）
# DATA_DIR=./data

# 微信公众号服务器校验 Token（M4 启用前配置；正式凭证走后台 WechatAccount）
# WECHAT_MP_VERIFY_TOKEN=
