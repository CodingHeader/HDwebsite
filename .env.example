# 环境变量示例文件
# 复制此文件为 .env.local 并填入实际值

# JWT密钥 - 必须设置，用于Token签名和验证
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# 数据库URL（如需覆盖默认配置）
# DATABASE_URL="file:./prisma/dev.db"

# 生产启动端口（默认 6789；宝塔推荐外部 80 反向代理到内部 6789）
# PORT=6789

# Docker/Compose 部署可选：主机对外暴露端口与容器内部端口
# HOST_PORT=6789
# APP_PORT=6789

# 目标域名（用于部署记录/后续反向代理）
# APP_DOMAIN=www.hd1994.com
