# 复制为 .env.local 并填入实际值（密钥绝不入库、绝不写入文档）
# 必需键：JWT_SECRET / ENCRYPTION_KEY（任何环境，≥32 字符，缺失启动即 FATAL）
# 生产必需键：DATABASE_URL / APP_ORIGIN（NODE_ENV=production 时缺失即 FATAL）

# JWT 密钥（必需，≥32 字符）
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long

# 字段加密密钥（必需，≥32 字符；AES-256-GCM，覆盖 LLM apiKey/微信 appSecret/SMTP password）
# 注意：本键无派生来源——env.ts 直接读取，全仓库无任何派生逻辑，须显式配置
ENCRYPTION_KEY=your-encryption-key-also-min-32-chars-long

# 数据库（生产必需；开发可省略，默认 file:./prisma/dev.db）
DATABASE_URL="file:./prisma/dev.db"

# 站点绝对链接基准（生产必需；开发可省略，邮件/素材绝对链接使用）
APP_ORIGIN=https://www.hd1994.com

# 主机（可选，有默认值；生产默认 0.0.0.0）
HOSTNAME=0.0.0.0

# 生产端口（可选，默认 6789；宝塔 80 反代 → 127.0.0.1:6789）
PORT=6789

# 站点域名（可选，邮件/素材绝对链接使用）
APP_DOMAIN=www.hd1994.com

# 运行时数据目录（可选，默认 ./data；上传/切片/导出等运行时文件落此）
DATA_DIR=./data

# 容器时区（V11-COL-02：Dockerfile/compose 已内置 TZ=Asia/Shanghai；本机直跑且需指定时区时取消注释）
# TZ=Asia/Shanghai

# 微信公众号服务器校验 Token（M4 启用前配置；正式凭证走后台 WechatAccount）
# WECHAT_MP_VERIFY_TOKEN=
