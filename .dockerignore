# Dockerfile：本仓库根目录 Dockerfile（生产，standalone）
Dockerfile
# Dockerfile.dev：本仓库开发件（如后续新增）
Dockerfile.dev
# Compose：本仓库根目录 docker-compose.yml
docker-compose.yml
# dockerignore：镜像上下文
.dockerignore

# 依赖（容器内 npm ci 重新安装）
node_modules
