.next
out
build
dist

# 缓存与诊断
.cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# VCS
.git
.gitignore
.gitattributes

# 环境文件（凭证通过 docker-compose env_file / 运行时注入）
.env
.env.local
.env.production
.env.development
.env.test
.env.*
.env.*.local
.env.*.local.*
!.env.example

# 运行时数据目录（D-09 起生效；挂载卷持久化）
data
uploads

# 备份与本地数据库（容器外维护）
backups
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal

# 临时日志与测试产物
*.log
.smoke*.log
.verify-*.log
tests
playwright-report
test-results

# 本地运行时/工具目录
.box-agent
.box-agent-scratch

# 文档与 Agent 规则（不参与镜像构建）
docs
AGENTS.md
CLAUDE.md
README.md
CHANGELOG.md
LICENSE
